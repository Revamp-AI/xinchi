# Required: PostgreSQL 16+ database. Use the Neon pooled URL for app traffic.
# Example only; replace with your private connection string.
DATABASE_URL=postgresql://focus:replace-me@127.0.0.1:5432/focus
# Optional direct Neon URL for schema migrations (defaults to DATABASE_URL).
# DATABASE_URL_UNPOOLED=postgresql://role:password@direct-host/database?sslmode=require

# Required: the sole Google account allowed to open this workspace.
XIN_ALLOWED_EMAIL=owner@example.com

# Vercel production: the sole allowed HTTPS origin and cloud runtime.
# XIN_APP_ORIGIN=https://your-project.vercel.app
# XIN_AGENT_MODE=cloud
# XIN_AGENT_MODEL=openai/gpt-6-astra
# XIN_TIME_ZONE=Asia/Singapore
# XIN_SECRET_STORAGE=postgres
# XIN_SECRETS_KEY=<32 random bytes encoded as base64url; keep backed up privately>
# CRON_SECRET=<random secret for the scheduled worker endpoint>
# GOOGLE_CLIENT_ID=<OAuth Web client ID>
# GOOGLE_CLIENT_SECRET=<OAuth Web client secret>
# AI Gateway uses Vercel OIDC in production; no provider API key is needed.

# Optional: override the participant filter used by Fireflies.
# XIN_FIREFLIES_PARTICIPANT_EMAIL=owner@example.com
# XIN_DATA_DIR=/absolute/path/to/private/data
# XIN_CODEX_BIN=/absolute/path/to/codex

# Upload the Google OAuth Web application client JSON on the login screen.
# Set provider API keys in Connections. Never commit credentials.
