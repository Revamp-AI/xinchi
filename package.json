{
  "name": "focus-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3210",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "test": "node scripts/test-postgres.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.jsx\" \"components/focus/**/*.{jsx,css}\" \"hooks/**/*.ts\" \"lib/*.ts\"",
    "format:check": "prettier --check \"app/**/*.jsx\" \"components/focus/**/*.{jsx,css}\" \"hooks/**/*.ts\" \"lib/*.ts\"",
    "test:e2e": "node scripts/test-postgres.mjs --e2e",
    "agent-worker": "node scripts/worker.mjs",
    "import": "node --env-file-if-exists=.env.local scripts/import.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import-sqlite": "node --env-file-if-exists=.env.local scripts/migrate-sqlite.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
